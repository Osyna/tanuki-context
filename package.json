{
  "name": "tanuki-context",
  "version": "0.20.1",
  "description": "Cut 79-91% of the input tokens your logs and command output cost. MCP server or drop-in proxy: park bytes outside the conversation, fetch exact slices, draw a slice as dense PNG pages when that is cheaper - and it says when plain text is cheaper instead. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tanuki-context": "dist/cli.js"
  },
  "exports": {
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --minify --outfile=dist/cli.js && bun build src/agent.ts --target=node --minify --external @anthropic-ai/claude-agent-sdk --external zod --outfile=dist/agent.js && bun build src/pi.ts --target=node --minify --external typebox --outfile=dist/pi.js && cp types/agent.d.ts dist/agent.d.ts",
    "prepublishOnly": "bun run build",
    "parity": "bun reference/parity-ts.mjs",
    "parity:proxy": "node reference/proxy-parity.mjs",
    "test": "bun test",
    "tiers": "node reference/tiers-report.mjs",
    "needles": "node reference/needle-report.mjs",
    "paired": "node reference/paired-report.mjs",
    "taskqual": "node reference/task-report.mjs",
    "tier": "node reference/tier-report.mjs",
    "coverage": "bun reference/coverage-report.mjs",
    "adversarial": "bun reference/adversarial-report.mjs",
    "tokenizer": "node reference/tokenizer-report.mjs",
    "trace": "node reference/loop-trace.mjs",
    "retrieval": "node reference/retrieval-report.mjs",
    "crush": "node reference/crush-report.mjs --min 60",
    "combined": "node reference/combined-report.mjs --min 90"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "typebox": "^1.0.0",
    "zod": "^4.0.0"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osyna/tanuki-context.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "context",
    "context-window",
    "compression",
    "tokens",
    "token-savings",
    "cost-optimization",
    "llm",
    "proxy",
    "logs",
    "anthropic",
    "claude",
    "openai",
    "gemini",
    "pxpipe"
  ]
}
